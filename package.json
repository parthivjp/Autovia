{
  "name": "mytask",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "server": "npm --prefix backend run dev",
    "client": "vite --host 0.0.0.0",
    "dev": "concurrently \"npm:server\" \"npm:client\"",
    "seed": "npm --prefix backend run seed",
    "test:backend": "npm --prefix backend test",
    "build": "vite build",
    "lint": "oxlint .",
    "preview": "vite preview --host 0.0.0.0"
  },
  "dependencies": {
    "concurrently": "^10.0.6",
    "framer-motion": "^14.6.0",
    "lucide-react": "^1.61.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-hot-toast": "^2.6.1",
    "react-router-dom": "^7.18.4"
  },
  "devDependencies": {
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "oxlint": "^1.88.0",
    "vite": "^8.3.4"
  }
}
